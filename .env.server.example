# Copy to .env on the control server before deploy.

# Telegram
TELEGRAM_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_USERNAME=@vpn_appguard_bot
CHANNEL_USERNAME=@kirillprodev
ADMIN_USERNAMES=kkasyanov

# Telegram local dev
ALLOW_LOCAL_WEBAPP=false
DEV_TELEGRAM_ID=999000
DEV_TELEGRAM_USERNAME=kirillprodev

# Internal PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=vpnbot
PG_USER=vpnbot
PG_PASSWORD=change_this_postgres_password

# PostgreSQL container
POSTGRES_DB=vpnbot
POSTGRES_USER=vpnbot
POSTGRES_PASSWORD=change_this_postgres_password

# Public control host
SERVER_IP=45.87.247.206
WEBAPP_URL=https://REPLACE_WITH_CONTROL_DOMAIN
VITE_API_BASE=https://REPLACE_WITH_CONTROL_DOMAIN/api
VITE_CHANNEL_USERNAME=@kirillprodev
LEGAL_SERVICE_NAME=VPN Guard
LEGAL_OWNER_NAME=REPLACE_WITH_OWNER_NAME
LEGAL_CONTACT_EMAIL=support@REPLACE_WITH_CONTROL_DOMAIN
LEGAL_CONTACT_ADDRESS=REPLACE_WITH_POSTAL_ADDRESS
SUPPORT_EMAIL=support@REPLACE_WITH_CONTROL_DOMAIN
SUPPORT_HOURS=Mon-Fri 10:00-18:00 UTC
SUPPORT_TICKET_URL=

# Public app list for mini app
SERVERS_JSON=[{"id":"foreign-vless-main","name":"Foreign VLESS Main","host":"vpnnew1.com","ip":"176.98.191.110","location":"Finland","country_code":"FI","protocol":"VLESS","is_default":true,"status":"online","role":"vpn-node","profile_format":"uri"}]

# VPN API provider
VPN_PROVIDER_MODE=remote-http
VPN_BACKEND_URL=http://vpn-backend:3020
VPN_BACKEND_TOKEN=
VPN_BACKEND_TIMEOUT_MS=10000
VPN_PROTOCOL_LABEL=VLESS
VPN_PROFILE_FORMAT=uri
VPN_ACCESS_SCHEME=vless
VPN_ACCESS_PORT=443
VPN_PROFILE_TEMPLATE_JSON=

# VPN backend nodes
VPN_BACKEND_PROTOCOL=VLESS
VPN_BACKEND_PROFILE_FORMAT=uri
VPN_BACKEND_NODES_JSON=[{"id":"foreign-vless-main","name":"Foreign VLESS Main","host":"vpnnew1.com","ip":"176.98.191.110","port":443,"country_code":"FI","transport":"tcp","security":"tls","sni":"vpnnew1.com","enabled":true,"is_default":true}]
